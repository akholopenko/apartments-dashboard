      "input[name='password']",
      "input[type='password']"
    ],
    "submit": [
      "button[type='submit']",
      "button:has-text('Sign in')",
      "button:has-text('Log in')",
      "button:has-text('Войти')"
    ],
    "refresh": [
      "button:has-text('Refresh connection')",
      "button:has-text('Update connection')",
      "button:has-text('Actualizar conexión')",
      "button:has-text('Обновить подключение')"
    ]
